# ============================================================
# Referoo — Environment Variables
# Copy this to .env in backend/ and worker/ directories.
# For frontend, copy to frontend/.env.local
# NEVER commit real secrets to git.
# ============================================================

# Shared
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/referoo
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Azure Blob Storage
BLOB_STORAGE_ACCOUNT=
BLOB_STORAGE_CONTAINER_RESUMES=resumes
BLOB_STORAGE_CONTAINER_EXPORTS=exports
BLOB_STORAGE_CONTAINER_AI_OUTPUTS=ai-outputs

# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=

# Azure AI Foundry
AI_FOUNDRY_ENDPOINT=
AI_FOUNDRY_API_KEY=

# Gamma API
GAMMA_API_KEY=

# Azure Application Insights
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
